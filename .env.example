# Local-only development values. Copy to .env and replace both passwords.
# POSTGRES_USER is the Docker initialization/admin account; FastAPI uses ota_app.
POSTGRES_DB=ota_dev
POSTGRES_USER=ota_admin
POSTGRES_PASSWORD=change-this-local-admin-password
POSTGRES_APP_USER=ota_app
POSTGRES_APP_PASSWORD=change-this-local-app-password
DATABASE_URL=postgresql+psycopg://ota_app:change-this-local-app-password@127.0.0.1:5432/ota_dev
OTA_ADMIN_TOKEN=replace-with-a-long-random-local-publishing-token
OTA_SIGNING_PUBLIC_KEY_PATH=.local-keys/ota-publisher-public.pem
OTA_STORAGE_DIR=storage/releases
OTA_API_BASE_URL=http://127.0.0.1:8000
# Optional external origin used in download URLs behind ngrok/reverse proxies.
OTA_PUBLIC_BASE_URL=
